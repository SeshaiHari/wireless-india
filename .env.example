# --- Payload CMS -----------------------------------------------------------
# Postgres connection string (Neon via Vercel Storage works on the free tier).
# Leave blank to run the site on the local seed catalog (no CMS).
DATABASE_URL=
# Any long random string. Used to sign admin logins.
PAYLOAD_SECRET=
# Vercel Blob for images: set by Vercel when you connect a Blob store.
# Either BLOB_STORE_ID (OIDC, the default now) or BLOB_READ_WRITE_TOKEN works.
# Neither set = images stored in ./media locally.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=
