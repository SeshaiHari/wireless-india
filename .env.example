# --- Payload CMS -----------------------------------------------------------
# Postgres connection string (Neon via Vercel Storage works on the free tier).
# Leave blank to run the site on the local seed catalog (no CMS).
DATABASE_URL=
# Any long random string. Used to sign admin logins.
PAYLOAD_SECRET=
# Vercel Blob token for image uploads. Blank = images stored in ./media locally.
BLOB_READ_WRITE_TOKEN=

# --- One-off Sanity → Payload migration (npm run migrate:sanity) ---------------
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed if the Sanity dataset is private (Viewer token).
SANITY_READ_TOKEN=

NEXT_PUBLIC_SITE_URL=
